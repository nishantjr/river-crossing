cabal-version:      3.0
name:               wxyzmonad
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nishant Rodrigues
maintainer:         nishantjr@gmail.com
-- copyright:
category:           Graphics
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:


-- We disable the ambiguous-fields warning since there's no real alternative,
-- untile OverloadedRecordUpdate is stable.
-- See: https://discourse.haskell.org/t/what-are-you-supposed-to-do-about-wambiguous-fields/9545/13
common warnings
    ghc-options: -Wall -Wno-ambiguous-fields

common language
    default-language: GHC2024
    default-extensions:
        OverloadedRecordDot,
        DuplicateRecordFields,
        NoFieldSelectors

library
    import:           language, warnings
    hs-source-dirs:   src/
    exposed-modules:  WXYZ.Protocol
                    , WXYZ.XKB
                    , WXYZ.River
                    , WXYZ.Layout.Core
    include-dirs:     .build/protocol/,
                      .
    c-sources:        cbits/river.c
                    , .build/protocol/river-window-management-v1-private.c
                    , .build/protocol/river-xkb-bindings-v1-private.c
                    , .build/protocol/river-layer-shell-v1-private.c
    pkgconfig-depends:
      , wayland-client
      , xkbcommon
    build-depends:    base >=4.18.3.0 && < 5
                    , containers
                    , data-default-class
                    , directory
                    , extra
                    , filepath
                    , mtl
                    , process
                    , time
                    , transformers
                    , unix

executable wxyz
    import:           language, warnings
    main-is:          Main.hs
    build-depends:
        base >=4.18.3.0 && < 5
      , containers
      , mtl
      , transformers
      , wxyzmonad
    hs-source-dirs:   exe

test-suite unit-test
    import:           language, warnings
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs:
        unit-test
    build-depends:
        wxyzmonad
      , tasty
      , tasty-hunit
      , base
